# Copy to scripts/mainnet/.env (gitignored). Addresses only: the deployer key lives in the Foundry keystore
# (`cast wallet import deployer --interactive`), never in this file or in a chat.
RPC_URL=robinhood                      # foundry.toml alias for https://rpc.mainnet.chain.robinhood.com
ACCOUNT=deployer                       # keystore name

# Roles. On mainnet (4663) the script requires every one of these to be a contract (a Safe).
ADMIN_SAFE=                            # proposes and executes through the 48 h TimelockController
GUARDIAN=                              # can only pause / disable
OPS_SAFE=                              # receives the 50% operations share
KEEPER=                                # the keeper bot's wallet (an EOA is fine)

# Chain facts (mainnet)
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

# Your token
KYTE_TOKEN=                            # live $KYTE on Robinhood Chain
KYTE_PER_ETH=                          # opening pool price, raw units: 1,000,000 KYTE/ETH with 18 decimals = 1000000000000000000000000

# Optional
# TIMELOCK=                            # reuse an existing TimelockController instead of deploying one
# TIMELOCK_DELAY=172800                # must be >= 172800 on mainnet
# FEE_BPS_PREMIUM=300
# FEE_BPS_EXERCISE=10

# Kyte on Elysium (Kinetiq's Hyperliquid L2, chain 99901). docs/ELYSIUM.md. Copy to scripts/mainnet/elysium.env.
# Never put a private key here: signing uses the Foundry keystore (ACCOUNT).
RPC_URL=https://rpc.elysium.kinetiq.xyz
CHAIN_ID=99901
ACCOUNT=deployer                       # keystore name; the wallet needs HYPE for gas (bridge from HyperEVM)

# Safes (step 1 creates them; Elysium carries Safe v1.3.0 at its canonical addresses, not v1.4.1)
SAFE_OWNERS=0x05aA80227aEEE19563FbAB8F05982723CF5c2e5B,0xB44E3a93957069374C3bd30499f9948386f2ABF9,0x32639BF2456bC69e1E59f68F7F56390299d5D455
ADMIN_THRESHOLD=2
GUARDIAN_THRESHOLD=1
SAFE_SINGLETON=0x3E5c63644E683549055b9Be8653de26E0B4CD36E
SAFE_FACTORY=0xa6B71E26C5e0845f74c812102Ca7114b6a896AB2
SAFE_FALLBACK=0xf48f2B2d2a534e402487b3ee7C18c33Aec0Fe5e4
# Filled by step 1 (deployments/safes-99901.json), or paste existing Safes:
ADMIN_SAFE=
GUARDIAN=
OPS_SAFE=

# Protocol inputs
WETH=0xbA876237B0F021A6c6D852d6c26E107997cC5E81          # WHYPE, the quote asset on Elysium
POOL_MANAGER=0xE2e105d3F7209A9DA11f83cCf3E7398a753823F1  # Uniswap v4 (recorded; no KyteHook until $KYTE is here)
KEEPER=0x377E8Ac104351173A1009Eb6bdCd9966174bBd4E        # the live keeper wallet (needs HYPE on Elysium)
TIMELOCK_DELAY=600

# First listings for the timelock plan (token:cap:minStrike:puts). cap in token units (18 decimals here),
# minStrike = minimum total strike in WHYPE wei. Deepest WHYPE pairs on 10 Nov 2026 (DexScreener):
# KNTQ (Kinetiq), e/acc, AETHER, A/ACC. Puts on for all four.
ASSETS=0xe45a355d9e9cAd2aD85F2d03E3eE3102A036acF0:10000000000000000000000000:1000000000000000:1,0x8df4f39d592de2aAee15838B265C2392d19A4128:10000000000000000000000000:1000000000000000:1,0xf31BceD2eA8F160052D54c8a3fD03381FEDD8E0D:10000000000000000000000000:1000000000000000:1,0xAACC5bc6EA24CB753E5C2D48C88f7e361a50AACC:10000000000000000000000000:1000000000000000:1

# Copy to .env in the repo root (gitignored): cp docker/compose.env.example .env
# docker compose reads it automatically.

# ---- chain (indexer, keeper and site) -- 4663 = Robinhood Chain mainnet, 46630 = testnet
CHAIN_ID=4663
# Leave empty for the official Robinhood RPC. A private RPC is recommended in production.
RPC_URL=
# Block the protocol was deployed at (103214110 = current mainnet deploy). The API opens once it has caught up.
START_BLOCK=103214110

# ---- indexer
# Origins allowed to call the API, e.g. https://kyte.sh (empty = *)
CORS_ORIGINS=
# 1 when the caddy proxy (or another proxy you run) sits in front, so rate limits use the real client IP
TRUST_PROXY=0
INDEXER_PORT=4200

# ---- website (baked in at build time: rebuild the web image after changing these)
# Public URL the BROWSER uses for the indexer, e.g. https://api.kyte.sh (local: http://localhost:4200)
NEXT_PUBLIC_INDEXER_URL=http://localhost:4200
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_PRIVY_APP_ID=cmvv5q9or008m0ijyddu8fpv5
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_DEMO=0
WEB_PORT=3010

# ---- keeper (profile "keeper"); the private key goes in docker/secrets/keeper_key, never here
KEEPER_INTERVAL_MS=30000
BUYBACK_MIN_WETH=0.01
BUYBACK_SLIPPAGE_BPS=100
MAX_GAS_GWEI=1
MAX_SPOT_TWAP_DEVIATION_BPS=300
KEEPER_MIN_ETH=0.02
ALERT_WEBHOOK_URL=

# ---- TLS proxy (profile "proxy"); both DNS records must point at this server
SITE_DOMAIN=kyte.sh
API_DOMAIN=api.kyte.sh

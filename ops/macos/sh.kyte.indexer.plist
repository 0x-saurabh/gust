<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>sh.kyte.indexer</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Volumes/my_files/newii/gust-website/ops/run-indexer.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>/Users/apple/Library/Logs/kyte-indexer.log</string>
  <key>StandardErrorPath</key><string>/Users/apple/Library/Logs/kyte-indexer.log</string>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>/Users/apple</string></dict>
</dict>
</plist>

# Copy to ops/docker/prod.env and run:  docker compose --env-file ops/docker/prod.env up -d --build
SITE_ORIGIN=https://kyte.sh                 # your site's public URL
INDEXER_PUBLIC_URL=https://api.kyte.sh      # public HTTPS URL that reaches the indexer (port 4200 behind your proxy)
PRIVY_APP_ID=                               # from the Privy dashboard; add SITE_ORIGIN to its allowed origins
ALERT_WEBHOOK_URL=                          # optional Slack/Discord webhook for keeper alerts
